{
    "name": "AtCoder",
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "remoteEnv": {
        "DEBUGINFOD_URLS": ""
    },
    "capAdd": [
        "SYS_PTRACE"
    ],
    "securityOpt": [
        "seccomp=unconfined"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "formulahendry.code-runner",
                "ms-python.python",
                "ms-vscode.cpptools"
            ],
            "settings": {
                "code-runner.executorMap": {
                    "cpp": "g++-15 -std=gnu++23 -O2 -march=native -pthread -fopenmp -Wall -Wextra \"$fullFileName\" -o /tmp/atcoder_cpp_run && /tmp/atcoder_cpp_run",
                    "python": "/home/venv/bin/python \"$fullFileName\""
                },
                "python.defaultInterpreterPath": "/home/venv/bin/python",
                "python-envs.terminal.autoActivationType": "off",
                "chat.disableAIFeatures": true,
                "C_Cpp.default.compilerPath": "/usr/bin/g++-15",
                "C_Cpp.default.cppStandard": "c++23"
            }
        }
    }
}