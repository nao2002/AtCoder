{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-15 debug build active file",
            "command": "/usr/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-std=gnu++23",
                "-Og",
                "-g3",
                "-Wall",
                "-Wextra",
                "-pthread",
                "-fopenmp",
                "${file}",
                "-o",
                "/tmp/atcoder_cpp_debug"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}