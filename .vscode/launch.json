{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ Active File",
            "type": "cppdbg",
            "request": "launch",
            "program": "/tmp/atcoder_cpp_debug",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++-15 debug build active file"
        }
    ]
}